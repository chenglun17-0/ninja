#!/bin/sh
# ninja q0 build shim (only ever prepended to PATH by vendor/ghostty/build.sh):
# zig 0.15.2 asks xcrun for the macOS SDK when detecting the native target,
# and ignores SDKROOT there. Xcode 26.6's SDK tbd stubs dropped arm64-macos
# (arm64e only), so every native zig link fails with undefined libc symbols.
# Answer "xcrun ... --show-sdk-path" with the newest CommandLineTools SDK
# whose libSystem.B.tbd still targets arm64-macos; delegate everything else.
set -eu
newest=""
for cand in /Library/Developer/CommandLineTools/SDKs/MacOSX*.sdk; do
  [ -f "${cand}/usr/lib/libSystem.B.tbd" ] || continue
  if awk '/^targets:/ {print; exit}' "${cand}/usr/lib/libSystem.B.tbd" 2>/dev/null | grep -qw "arm64-macos"; then
    newest="${cand}"
  fi
done
if [ -z "${newest}" ]; then
  echo "xcrun-shim: no CommandLineTools SDK with arm64-macos stubs" >&2
  exit 1
fi
for a in "$@"; do
  case "${a}" in
    --show-sdk-path)
      echo "${newest}"
      exit 0
      ;;
  esac
done
exec /usr/bin/xcrun "$@"
